# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — only needed for the verify:*/seed scripts, which act as
# an admin to set up and tear down test data. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
